{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "rocky8-openmp-release",
      "displayName": "Rocky8 CascadeLake GCC11 OpenMP Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "TRILINOS_ROOT_DIR": "/mnt/home/cedelmaier/Projects/Software/spack/opt/spack/linux-rocky8-cascadelake/gcc-11.4.0/trilinos-16.0.0-jg6itzcs5ms7vsuecbejqfr7l3bbjm2f/",
        "TPL_ROOT_DIR": "${env:HOME}/mundyscratch"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "mpicxx",
        "CMAKE_CXX_FLAGS": "-O3 -march=native",
        "CMAKE_INSTALL_PREFIX": "${env:TPL_ROOT_DIR}",
        "CTEST_BUILD_FLAGS": "-j8",
        "CTEST_PARALLEL_LEVEL": "8",
        "CTEST_BUILD_NAME": "rocky8-openmp-release",

        "TPL_ENABLE_MPI": "ON",
        "Kokkos_ENABLE_SERIAL": "OFF",
        "Kokkos_ENABLE_OPENMP": "ON",
        "Kokkos_ENABLE_CUDA": "OFF",

        "Mundy_ENABLE_MundyCore": "ON",
        "Mundy_ENABLE_MundyMath": "ON",
        "Mundy_ENABLE_MundyMesh": "ON",
        "Mundy_ENABLE_MundyGeom": "ON",
        "Mundy_ENABLE_MundyMeta": "ON",
        "Mundy_ENABLE_MundyAgents": "ON",
        "Mundy_ENABLE_MundyShapes": "ON",
        "Mundy_ENABLE_MundyLinkers": "ON",
        "Mundy_ENABLE_MundyIo": "ON",
        "Mundy_ENABLE_MundyConstraints": "ON",
        "Mundy_ENABLE_MundyBalance": "OFF",
        "Mundy_ENABLE_MundyMotion": "OFF",
        "Mundy_ENABLE_MundyAlens": "ON",
        "Mundy_ENABLE_MundyDriver": "OFF",

        "Mundy_ENABLE_TESTS": "ON",
        "Mundy_ENABLE_GTest": "ON",
        "Mundy_ENABLE_STKFMM": "OFF",
        "Mundy_ENABLE_PVFMM": "OFF",
        "Mundy_TEST_CATEGORIES": "BASIC;CONTINUOUS;NIGHTLY;HEAVY;PERFORMANCE",

        "TPL_GTest_DIR": "${env:TPL_ROOT_DIR}",
        "TPL_OpenRAND_DIR": "${env:TPL_ROOT_DIR}",
        "TPL_fmt_DIR": "${env:TPL_ROOT_DIR}",

        "TPL_Kokkos_DIR": "${env:TRILINOS_ROOT_DIR}",
        "TPL_KokkosKernels_DIR": "${env:TRILINOS_ROOT_DIR}",
        "TPL_STK_DIR": "${env:TRILINOS_ROOT_DIR}",
        "TPL_Teuchos_DIR": "${env:TRILINOS_ROOT_DIR}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-rocky8-openmp-release",
      "configurePreset": "rocky8-openmp-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "ctest-rocky8-openmp-release",
      "configurePreset": "rocky8-openmp-release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
