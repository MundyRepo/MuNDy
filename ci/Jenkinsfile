properties([
  disableConcurrentBuilds(abortPrevious: true),
  buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
])

try {
  timeout(time: 6, unit: 'HOURS') {
    buildImage(context: 'ci')
    parallel cpu: {
      runPod(context: 'ci', cpus: 8) {
        withEnv([
          "HOME=${WORKSPACE}",
          "LC_ALL=C",
          "MUNDY_DEPS=${WORKSPACE}/mundy_deps_cpu",
          "MUNDY_INSTALL=${WORKSPACE}/mundy_install_cpu",
          "CTEST_BUILD_NAME=jenkins-cpu-release",
          "OMPI_MCA_rmaps_base_oversubscribe=1"
        ]) {
          stage('cpu deps') {
            sh './ci/build_jenkins_cpu_release.sh'
          }
          stage('cpu test') {
            try {
              sh './ci/test_jenkins_cpu_release.sh'
            } finally {
              junit allowEmptyResults: true, testResults: 'build/ctest_results.xml'
            }
          }
        }
      }
    },
    gpu: {
      runPod(context: 'ci', cpus: 8, gpus: 1, gpuType: 'a100') {
        withEnv([
          "HOME=${WORKSPACE}",
          "LC_ALL=C",
          "MUNDY_DEPS=${WORKSPACE}/mundy_deps_gpu",
          "MUNDY_INSTALL=${WORKSPACE}/mundy_install_gpu",
          "CTEST_BUILD_NAME=jenkins-gpu-release-sm80",
          "OMPI_MCA_rmaps_base_oversubscribe=1"
        ]) {
          stage('gpu deps') {
            sh './ci/build_jenkins_gpu_release.sh'
          }
          stage('gpu test') {
            try {
              sh './ci/test_jenkins_gpu_release.sh'
            } finally {
              junit allowEmptyResults: true, testResults: 'build/ctest_results.xml'
            }
          }
        }
      }
    }
  }
}
finally {
  emailFailure()
}