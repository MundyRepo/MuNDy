properties([
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
])

try {
  timeout(time: 6, unit: 'HOURS') {
    buildPod(context: 'ci') {
      withEnv([
        "HOME=${WORKSPACE}",
        "MUNDY_DEPS=${WORKSPACE}/mundy_deps",
        "MUNDY_INSTALL=${WORKSPACE}/mundy_install",
        "SPACK_ROOT=/home/testuser/spack",
        "SPACK_TRILINOS=tril161_cpu",
        "OMPI_MCA_rmaps_base_oversubscribe=1"
      ]) {
        stage('Dependencies') {
            echo 'Installing dependencies inside the container'
            sh './ci/build_jenkins_cpu_release.sh'
        }
        stage('Test') {
          // Drives the TriBITS CTest -S script: configures, builds, tests, and
          // submits per-package results to CDash (https://my.cdash.org/index.php?project=Mundy).
          // The script also converts CTest's Test.xml to JUnit so Jenkins keeps
          // its own test report alongside CDash.
          try {
            echo 'Configuring, building, testing, and submitting to CDash'
            sh './ci/test_jenkins_cpu_release.sh'
          } finally {
            junit allowEmptyResults: true, testResults: 'build/ctest_results.xml'
          }
        }
      }
    }
  }
}
finally {
  emailFailure()
}
